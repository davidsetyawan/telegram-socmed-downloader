# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real tokens.

# Required: token from @BotFather
BOT_TOKEN=

# Required: your Telegram numeric user ID (use @userinfobot to find it)
ADMIN_ID=

# Optional: max items per Telegram media-group (default 10)
# ALBUM_MAX=10

# Optional: max file size in bytes (default 50 MiB; Telegram public Bot API cap)
# MAX_FILE_BYTES=52428800

# Optional: only set if you run a Local Bot API server
# BASE_URL=
